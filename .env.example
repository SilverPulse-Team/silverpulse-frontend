# La demo integrada usa FastAPI. MOCK es opt-in para pruebas aisladas.
VITE_DATA_PROVIDER=http

# Base URL local de FastAPI. No contiene credenciales.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Escenarios mock: offline | after-delivery | after-return
VITE_MOCK_SCENARIO=offline

# Asistente de a bordo: requiere /ship/analyses (rama del asistente conversacional).
# Desactivado por defecto porque el backend MVP no expone esos endpoints.
VITE_ENABLE_SHIP_ASSISTANT=false
