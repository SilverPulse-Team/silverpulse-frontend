# Selección explícita de fuente de datos: mock | http
VITE_DATA_PROVIDER=mock

# Backend FastAPI. Es una URL pública de configuración; nunca colocar secretos VITE_*.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Escenarios mock: offline | after-delivery | after-return
VITE_MOCK_SCENARIO=offline
